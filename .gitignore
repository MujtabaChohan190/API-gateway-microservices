# ==========================================
# 1. Virtual Environments (Python Packages)
# ==========================================
# Prevents thousands of third-party dependency files from bloating your GitHub.
.venv/
venv/
env/

# ==========================================
# 2. Environment Variables & Secrets (CRITICAL)
# ==========================================
# Keeps your JWT secret keys, API keys, and port configurations safe and local.
.env
**/.env

# ==========================================
# 3. Python Compiled Caches
# ==========================================
# Blocks temporary files generated by Python when running your microservices.
**/__pycache__/
**/*.pyc

# ==========================================
# 4. IDE & Text Editor Settings
# ==========================================
# Prevents your personal layout/editor settings from forcing changes onto others.
.vscode/
.idea/